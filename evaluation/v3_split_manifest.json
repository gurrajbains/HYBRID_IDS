{
  "version": "V3",
  "purpose": "Freeze dataset roles before V3 model development and external evaluation.",
  "rules": {
    "final_holdouts_must_not_be_used_for_training": true,
    "final_holdouts_must_not_be_used_for_model_selection": true,
    "development_data_may_be_used_for_candidate_selection": true,
    "previously_examined_data_is_not_considered_untouched": true,
    "missing_features_must_not_be_fabricated": true
  },
  "training": {
    "cicids2017": [
      "data/cicids2017_multiclass.csv"
    ],
    "cse_cic_ids2018": [
      "Wednesday-14-02-2018_TrafficForML_CICFlowMeter.csv",
      "Thursday-15-02-2018_TrafficForML_CICFlowMeter.csv",
      "Friday-16-02-2018_TrafficForML_CICFlowMeter.csv",
      "Wednesday-21-02-2018_TrafficForML_CICFlowMeter.csv",
      "Thursday-01-03-2018_TrafficForML_CICFlowMeter.csv"
    ],
    "unsw_nb15": [
      "UNSW_NB15_training-set.csv"
    ]
  },
  "development": {
    "cse_cic_ids2018": [
      "Tuesday-20-02-2018_TrafficForML_CICFlowMeter.csv"
    ]
  },
  "final_holdout": {
    "cse_cic_ids2018": [
      "Thursday-22-02-2018_TrafficForML_CICFlowMeter.csv",
      "Friday-23-02-2018_TrafficForML_CICFlowMeter.csv"
    ],
    "unsw_nb15": [
      "UNSW_NB15_testing-set.csv"
    ]
  },
  "secondary_holdout": {
    "cse_cic_ids2018": [
      "Wednesday-28-02-2018_TrafficForML_CICFlowMeter.csv",
      "Friday-02-03-2018_TrafficForML_CICFlowMeter.csv"
    ]
  }
}